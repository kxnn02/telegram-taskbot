{
  "name": "telegram-taskbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevCon PH Cohort 5 Telegram task-management bot",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:next": "next build",
    "next:dev": "next dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json && tsc --noEmit -p tsconfig.next.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "sweep:test-cohorts": "tsx scripts/sweepStaleTestCohorts.ts",
    "seed:roster": "tsx scripts/seedRosterAndCohorts.ts",
    "dev": "tsx src/bot/index.ts",
    "start": "node dist/bot/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "chrono-node": "^2.7.7",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "luxon": "^3.5.0",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vercel/node": "^10.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
