{
  "name": "telegram-taskbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevCon PH Cohort 5 Telegram task-management bot",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:next": "next build",
    "next:dev": "next dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json && tsc --noEmit -p tsconfig.next.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "sweep:test-cohorts": "tsx scripts/sweepStaleTestCohorts.ts",
    "seed:roster": "tsx scripts/seedRosterAndCohorts.ts",
    "dev": "tsx src/bot/index.ts",
    "start": "node dist/bot/index.js",
    "webhook:register": "tsx scripts/registerWebhook.ts",
    "check:migrations": "tsx scripts/checkMigrationsApplied.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@grammyjs/auto-retry": "^2.0.2",
    "@supabase/supabase-js": "^2.112.4",
    "chrono-node": "^2.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "lucide-react": "^1.41.0",
    "luxon": "^3.5.0",
    "next": "^15.5.25",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vercel/node": "^10.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
